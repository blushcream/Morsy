<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.blushcream.Morsy</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>

  <name>Morsy</name>
  <summary>A simple Morse code translator with audio playback</summary>
  <description>
    <p>Morsy is a simple yet beautiful Morse code translator that converts text to Morse code or vice versa. It supports audio playback of the Morse code. Made with Rust, GTK4, and Libadwaita.</p>
  </description>

  <developer id="io.github.blushcream">
    <name>Blushcream</name>
  </developer>

  <url type="homepage">https://github.com/blushcream/Morsy/</url>

  <url type="vcs-browser">https://github.com/blushcream/Morsy/</url>

  <url type="bugtracker">https://github.com/blushcream/Morsy/issues</url>

  <translation type="gettext">morsy</translation>

  <launchable type="desktop-id">io.github.blushcream.Morsy.desktop</launchable>

  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#dba779</color>
    <color type="primary" scheme_preference="dark">#402e1f</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/blushcream/Morsy/master/screenshots/home.png</image>
      <caption>Home</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.0.0" date="2026-11-09">
      <description translate="no">
        <p>Initial Release</p>
        <ul>
          <li>Added Morse Code Characters</li>
        </ul>
      </description>
    </release>
  </releases>

</component>
