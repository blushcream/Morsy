//
using Gtk 4.0;
using Adw 1;

template $MorsyWindow: Adw.ApplicationWindow {
  title: _("Morsy");
  default-width: 650;
  default-height: 500;

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      MenuButton {
        primary: true;
        icon-name: 'open-menu-symbolic';
        tooltip-text: _("Main Menu");
        menu-model: primary_menu;
      }
      [end]
      Button play_button {
        icon-name: "media-playback-start-symbolic";
        tooltip-text: _("Play");

        styles ["success", "raised"]
      }
    }

    content: ScrolledWindow {
      Box {
        orientation: horizontal;
        spacing: 12;

        Frame {
          margin-start: 12;
          margin-bottom: 12;
          hexpand: true;
          vexpand: true;
          height-request: 250;
          width-request: 250;
          css-classes: ["view"];

          ScrolledWindow {
            TextView input_text {
              css-classes: ["input"];

              monospace: true;
              wrap-mode: word;
              top-margin: 12;
              bottom-margin: 12;
              left-margin: 12;
              right-margin: 12;
            }
          }
        }

        Frame {
          margin-end: 12;
          margin-bottom: 12;
          hexpand: true;
          vexpand: true;
          height-request: 250;
          width-request: 250;
          css-classes: ["view"];

          ScrolledWindow {
            hscrollbar-policy: never;
            vscrollbar-policy: automatic;
            TextView input_morse {
              css-classes: ["input"];

              monospace: true;
              wrap-mode: char;
              top-margin: 12;
              bottom-margin: 12;
              left-margin: 12;
              right-margin: 12;
            }
          }
        }
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Morsy");
      action: "app.about";
    }
  }
}